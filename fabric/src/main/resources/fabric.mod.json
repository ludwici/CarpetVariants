{
	"schemaVersion": 1,
	"id": "carpetvariants",
	"version": "${version}",
	"name": "Carpet Variants",
	"description": "A mod that gives you the ability to place carpets on walls and ceilings.",
	"authors": [
		"ludwici"
	],
	"contact": {
	},
	"license": "MIT",
	"icon": "assets/carpetvariants/logo.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.ludwici.carpetvariants.CarpetVariants"
		],
		"client": [
			"com.ludwici.carpetvariants.CarpetVariantsClient"
		]
	},
	"mixins": [
		"carpetvariants.mixins.json",
		{
			"config": "carpetvariants.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"carpetscore": ">=1.3.1"
	}
}