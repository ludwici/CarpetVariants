{
  "schemaVersion": 1,
  "id": "carpetvariants",
  "version": "${version}",
  "name": "Carpetvariants",
  "description": "A mod that gives you the ability to place carpets on walls and ceilings.",
  "authors": [
    "ludwici"
  ],
  "contact": {
    "homepage": "https://github.com/ludwici/CarpetVariants",
    "sources": "https://github.com/ludwici/CarpetVariants"
  },
  "license": "MIT",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.ludwici.carpetvariants.fabric.CarpetVariantsModFabric"
    ],
    "client": [
      "com.ludwici.carpetvariants.fabric.client.CarpetVariantsModFabricClient"
    ]
  },
  "mixins": [
    "carpetvariants.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.9",
    "minecraft": "~1.18.2",
    "java": ">=17",
    "architectury": ">=4.12.94",
    "fabric": "*"
  }
}
